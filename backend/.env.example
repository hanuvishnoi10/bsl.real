# ========================================================
# BRAZIL SENSI LEGENDS - BACKEND ENVIRONMENT CONFIGURATION
# ========================================================
#
# IMPORTANT: DO NOT COMMIT REAL SECRETS TO VERSION CONTROL!
# Fill in these values in your Render Web Service dashboard under "Environment Variables".

# Razorpay Credentials (from Razorpay Dashboard > Settings > API Keys)
# In Test mode, starts with: rzp_test_...
# In Live mode, starts with: rzp_live_...
RAZORPAY_KEY_ID=rzp_test_replace_with_your_key_id
RAZORPAY_KEY_SECRET=replace_with_your_key_secret

# Server Port (Render automatically sets PORT, defaults to 5000 locally)
PORT=5000
NODE_ENV=production

# CORS Allowed Origin
# Specify the exact URL of your deployed frontend (Render Static Site),
# or a comma-separated list of allowed origins.
# Example: https://brazilsensilegends.onrender.com,http://localhost:3000
# To allow all origins during initial testing, use *
CORS_ORIGIN=*

# Admin Credentials for Skyshot Security Portal (Optional)
ADMIN_USER=blazen
ADMIN_PASS=2437
